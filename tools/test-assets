#!/usr/bin/env python3
"""Read and verify development assets using the Run's original layout binding."""
import argparse
import json
from pathlib import Path
import sys
import zipfile
import xml.etree.ElementTree as ET
sys.path.insert(0, str(Path(__file__).resolve().parent))
from test_asset_operations import main as operation_main
from test_assets import asset_path, load_layout, read_index, validate_run

ROOT = Path(__file__).resolve().parents[1]


def legacy_main():
    parser = argparse.ArgumentParser(description=__doc__, epilog="Additional commands: begin, scope, finish, path-ref, replay, archive, verify-archive, restore, release-work. Use COMMAND --help for their arguments.")
    command = parser.add_subparsers(dest='command', required=True)
    resolved = command.add_parser('resolved')
    resolved.add_argument('--asset-config')
    for name in ('list', 'validate', 'path'):
        sub = command.add_parser(name)
        sub.add_argument('change')
        if name != 'list': sub.add_argument('run')
        if name == 'path': sub.add_argument('path', help='Run-relative inventoried asset path')
    for name in ('archive', 'restore', 'verify-archive', 'release-work'):
        sub = command.add_parser(name)
        sub.add_argument('change')
        sub.add_argument('identity', help='Run ID, or archive ID for verify-archive')
        if name == 'restore': sub.add_argument('--archive-id')
    args = parser.parse_args()
    try:
        if args.command == 'resolved': result = load_layout(ROOT, args.asset_config).resolved()
        elif args.command == 'release-work':
            from test_asset_cleanup import release_work
            result = release_work(ROOT, args.change, args.identity)
            print(json.dumps(result, ensure_ascii=False, indent=2))
            return 0 if result['completed'] else 1
        elif args.command in ('archive', 'restore', 'verify-archive'):
            from test_asset_archives import archive_run, restore_run, verify_archive
            if args.command == 'archive': result = archive_run(ROOT, args.change, args.identity)
            elif args.command == 'restore':
                result = restore_run(ROOT, args.change, args.identity, args.archive_id)
                if result['consumerStatus'] == 'pending':
                    print(json.dumps(result, ensure_ascii=False, indent=2))
                    return 1
            else:
                result = verify_archive(ROOT, args.change, args.identity)
                print(json.dumps(result, ensure_ascii=False, indent=2))
                return 0 if result['valid'] else 1
        elif args.command == 'list': result = read_index(ROOT, args.change)
        elif args.command == 'validate':
            result = validate_run(ROOT, args.change, args.run)
            print(json.dumps(result, ensure_ascii=False, indent=2))
            return 0 if result['valid'] else 1
        else:
            print(asset_path(ROOT, args.change, args.run, args.path))
            return 0
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0
    except (OSError, ValueError, KeyError, StopIteration, ET.ParseError, zipfile.BadZipFile) as error:
        print(f'ASSET_ERROR={error}', file=sys.stderr)
        return 2

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ('begin', 'scope', 'finish', 'path-ref', 'replay'):
        return operation_main()
    return legacy_main()


if __name__ == '__main__': sys.exit(main())
