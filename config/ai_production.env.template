# AI Provider Production Configuration Template
# Copy this file to .env.production and fill in your values

# ============================================================================
# DeepSeek API Configuration (Required)
# ============================================================================
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Model selection
# Options: deepseek-v4-flash (fast), deepseek-v4 (balanced), deepseek-v4-pro (high quality)
DEEPSEEK_MODEL=deepseek-v4-flash

# API endpoint (usually https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================================================
# AI Provider Performance Configuration
# ============================================================================
# Maximum concurrent API requests (default: 4)
# Increase for better throughput, decrease to reduce rate limiting
AI_PROVIDER_MAX_CONCURRENT=4

# Request timeout in seconds (default: 30.0)
AI_PROVIDER_TIMEOUT=30.0

# Reasoning detail level (default: detailed)
# Options: concise (fastest), step_by_step, detailed (best quality)
AI_PROVIDER_REASONING_LEVEL=detailed

# ============================================================================
# Retry Configuration
# ============================================================================
# Maximum retry attempts for failed API calls (default: 1 = no retry)
# Set to 3-5 for production reliability
AI_RETRY_MAX_ATTEMPTS=3

# Base delay between retries in seconds (default: 1.0)
AI_RETRY_BASE_DELAY=1.0

# Maximum delay between retries in seconds (default: 8.0)
AI_RETRY_MAX_DELAY=8.0

# Exponential backoff base (default: 2.0)
AI_RETRY_EXPONENTIAL_BASE=2.0

# ============================================================================
# Fallback Configuration
# ============================================================================
# Fallback strategy when capabilities fail (default: partial)
# Options: none (no fallback), partial (allowlisted capabilities only), full
AI_FALLBACK_STRATEGY=partial

# Capabilities allowed during partial fallback (comma-separated)
# Options: parse, verify, safety, vision, decision
AI_FALLBACK_ALLOWLIST=verify,vision

# Enable internal validation (default: true)
AI_ENABLE_VALIDATION=true

# ============================================================================
# Vision Service Configuration
# ============================================================================
# Vision service type (default: claude)
# Options: claude (Anthropic Claude), mimo (Xiaomi MiMo), mock (testing)
VISION_SERVICE_TYPE=claude

# Anthropic API key for Claude vision
VISION_API_KEY=your-anthropic-api-key-here

# Claude model for vision analysis
VISION_MODEL=claude-3-5-sonnet-20241022

# Vision request timeout in seconds (default: 30.0)
VISION_TIMEOUT=30.0

# Maximum retries for vision calls (default: 3)
VISION_MAX_RETRIES=3

# ============================================================================
# Metrics and Monitoring
# ============================================================================
# Enable metrics collection (default: true)
AI_ENABLE_METRICS=true

# Enable failure archiving (default: true)
AI_ENABLE_ARCHIVING=true

# Maximum failure records to keep (default: 1000)
AI_FAILURE_MAX_RECORDS=1000

# ============================================================================
# Cost Management
# ============================================================================
# Token usage alert threshold (default: 100000)
# Alert when total tokens exceed this threshold in a session
AI_TOKEN_ALERT_THRESHOLD=100000

# ============================================================================
# Feature Flags
# ============================================================================
# Enable AI advisor in TraversalEngine (default: false)
# Set to true to enable AI-powered traversal
ENABLE_AI_ADVISOR=false

# Minimum confidence for AI decisions (default: 0.7)
# Decisions below this threshold return UNSURE
AI_MIN_CONFIDENCE=0.7

# AI response cache TTL in seconds (default: 300)
# Cache responses for this duration to reduce API calls
AI_CACHE_TTL=300
