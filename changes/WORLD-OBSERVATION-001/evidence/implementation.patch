+                (double)item.Bounds.X1 / width, (double)item.Bounds.Y1 / height,
+                (double)item.Bounds.X2 / width, (double)item.Bounds.Y2 / height,
+                "device-viewport"), null, capture.Space)).ToArray();
+    }
+
