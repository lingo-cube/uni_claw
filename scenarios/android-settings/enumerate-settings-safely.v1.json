{
  "schemaVersion": "1",
  "scenarioId": "enumerate-settings-safely",
  "description": "Enumerate unique first-level Android Settings entries, sample safe read-only pages, and skip dangerous entries.",
  "appPackage": "com.android.settings",
  "entryStrategy": "cold_launch",
  "mode": "enumerate_first_level",
  "target": null,
  "boundaries": {
    "allowedPages": [
      "Settings"
    ],
    "maxDepth": 2,
    "maxSteps": 120,
    "maxScrolls": 12,
    "maxDurationSeconds": 3600
  },
  "allowedActions": [
    "back",
    "click",
    "launch",
    "scroll",
    "wait"
  ],
  "safetyPolicy": {
    "policyId": "settings-read-only-v1",
    "path": "policies/settings-read-only.v1.json"
  },
  "successCriteria": {
    "kind": "verified_end_of_list",
    "expectedPageIdentities": [
      "Settings"
    ],
    "requireEndOfList": true
  },
  "resetProcedure": {
    "actions": [
      "back",
      "launch",
      "wait"
    ],
    "expectedPageIdentity": "Settings",
    "timeoutSeconds": 20
  },
  "excludePatterns": [
    "search",
    "Search",
    "QSearch"
  ]
}
