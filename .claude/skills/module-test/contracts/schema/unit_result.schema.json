{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uni-claw.dev/schemas/unit_result.schema.json",
  "title": "Uni-Claw Unit Test Result",
  "description": "Standardized unit test result contract for validation reporting and CI/CD integration",
  "type": "object",
  "required": ["module", "timestamp", "summary"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version for compatibility tracking (major.minor)",
      "examples": ["1.0", "1.1", "2.0"]
    },
    "test_id": {
      "type": "string",
      "description": "Unique identifier for this test run (optional, generated by CI system)",
      "examples": ["run-abc123", "gh-456"]
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Module name (lowercase + underscores only, must match code directory)",
      "examples": ["simulation", "ai", "state_machine", "trace_models"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Test execution timestamp (ISO 8601, UTC)",
      "examples": ["2026-06-05T12:00:00Z", "2026-06-06T10:30:42.123Z"]
    },
    "environment": {
      "type": "object",
      "description": "Test execution environment (optional)",
      "properties": {
        "os": {
          "type": "string",
          "description": "Operating system",
          "examples": ["darwin", "linux", "windows"]
        },
        "python_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Python version",
          "examples": ["3.10.12", "3.11.0"]
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA",
          "examples": ["a1b2c3d", "a1b2c3d4e5f6"]
        },
        "git_branch": {
          "type": "string",
          "description": "Git branch name",
          "examples": ["main", "feature/new-tracer"]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "description": "Test execution summary",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tests"
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of passed tests"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of failed assertions"
        },
        "error": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of error conditions (legacy singular form)"
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of error conditions (preferred plural form)"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of skipped tests"
        },
        "success_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Calculated success rate (passed/total)"
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Test execution duration in milliseconds",
      "examples": [1234, 5678]
    },
    "failures": {
      "type": "array",
      "description": "List of test failures and errors",
      "items": {
        "type": "object",
        "required": ["test_name", "message", "type"],
        "properties": {
          "test_name": {
            "type": "string",
            "description": "Name of the failed test"
          },
          "file": {
            "type": "string",
            "description": "File containing the test (optional)",
            "examples": ["tests/v6/test_trace_models.py"]
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number of failure (optional)"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "description": "Failure message (truncated if too long)"
          },
          "type": {
            "type": "string",
            "enum": ["failure", "error"],
            "description": "Type of failure"
          },
          "traceback": {
            "type": "string",
            "description": "Full traceback (optional, include for debugging)"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Code coverage metrics (optional)",
      "properties": {
        "line_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Line coverage rate (0.0 to 1.0)"
        },
        "branch_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Branch coverage rate (0.0 to 1.0)"
        },
        "lines_covered": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of lines covered"
        },
        "lines_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of lines"
        },
        "report_file": {
          "type": "string",
          "description": "Path to detailed coverage report (if available)"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Additional artifact references (optional)",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["log", "screenshot", "coverage", "trace", "other"],
            "description": "Type of artifact"
          },
          "path": {
            "type": "string",
            "description": "Path to artifact file"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description (optional)"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for tool use (optional)",
      "properties": {
        "test_runner": {
          "type": "string",
          "examples": ["pytest", "unittest"]
        },
        "ci_system": {
          "type": "string",
          "examples": ["github-actions", "jenkins", "local"]
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "User-defined tags for categorization"
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "module": "trace_models",
      "timestamp": "2026-06-06T10:30:42Z",
      "environment": {
        "os": "darwin",
        "python_version": "3.10.12",
        "git_sha": "a1b2c3d",
        "git_branch": "main"
      },
      "summary": {
        "total": 33,
        "passed": 33,
        "failed": 0,
        "errors": 0,
        "skipped": 0,
        "success_rate": 1.0
      },
      "duration_ms": 1234,
      "failures": [],
      "coverage": {
        "line_rate": 0.92,
        "branch_rate": 0.85,
        "lines_covered": 184,
        "lines_total": 200
      },
      "metadata": {
        "test_runner": "pytest",
        "ci_system": "local"
      }
    },
    {
      "schema_version": "1.0",
      "module": "simulation",
      "timestamp": "2026-06-05T14:15:30Z",
      "summary": {
        "total": 25,
        "passed": 23,
        "failed": 1,
        "errors": 1,
        "skipped": 0,
        "success_rate": 0.92
      },
      "duration_ms": 5678,
      "failures": [
        {
          "test_name": "test_simulation_with_invalid_config",
          "file": "tests/v6/test_simulation.py",
          "line": 42,
          "message": "AssertionError: Expected ValueError but got None",
          "type": "failure"
        }
      ]
    }
  ]
}
