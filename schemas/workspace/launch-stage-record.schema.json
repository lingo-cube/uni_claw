{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniclaw.dev/schemas/workspace/launch-stage-record/v1",
  "title": "UniClaw Workspace LaunchStageRecord",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "uniclaw.workspace.launch-stage-record.v1"},
    "contractVersion": {"const": "uniclaw.workspace.contract.v1"},
    "stageId": {"type": "string", "minLength": 1},
    "stage": {"enum": ["requested", "instance-created", "run-bound", "host-session-bound", "observations-added", "completed", "failed"]},
    "status": {"enum": ["pending", "succeeded", "partial", "failed"]},
    "source": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "availability": {"enum": ["present", "partial", "unavailable", "not-collected", "not-applicable", "not-associated", "permission-denied"]},
    "valueOrigin": {"enum": ["configured", "generated", "observed", "derived"]},
    "taskInstanceId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "diagnostic": {"type": "object", "additionalProperties": false, "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}, "required": ["code", "message"]},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "required": ["schemaVersion", "contractVersion", "stageId", "stage", "status", "source", "authority", "availability", "valueOrigin", "recordedAt"],
  "allOf": [{"if": {"properties": {"stage": {"const": "run-bound"}}}, "then": {"properties": {"authority": {"const": "uniclaw-runtime"}, "valueOrigin": {"const": "generated"}}, "required": ["runId"]}}],
  "$defs": {
    "field": {"type": "object", "additionalProperties": false, "properties": {"key": {"type": "string", "minLength": 1}, "value": {}, "valueOrigin": {"enum": ["configured", "generated", "observed", "derived"]}, "availability": {"enum": ["present", "partial", "unavailable", "not-collected", "not-applicable", "not-associated", "permission-denied"]}, "source": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}, "observedAt": {"type": "string", "format": "date-time"}}, "required": ["key", "value", "valueOrigin", "availability", "source", "authority"]}
  }
}
