{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniclaw.dev/schemas/workspace/task-launch-ack/v1",
  "title": "UniClaw Workspace TaskLaunchAck",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "uniclaw.workspace.task-launch-ack.v1"},
    "contractVersion": {"const": "uniclaw.workspace.contract.v1"},
    "launchRequestId": {"type": "string", "minLength": 1},
    "launchId": {"type": "string", "minLength": 1},
    "taskInstanceId": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "partial", "completed", "failed"]},
    "stages": {"type": "array", "items": {"$ref": "https://uniclaw.dev/schemas/workspace/launch-stage-record/v1"}},
    "bindings": {"$ref": "https://uniclaw.dev/schemas/workspace/task-launch-ack/v1#/$defs/bindings"},
    "correlationId": {"type": "string", "minLength": 1},
    "acknowledgedAt": {"type": "string", "format": "date-time"}
  },
  "required": ["schemaVersion", "contractVersion", "launchRequestId", "launchId", "status", "stages", "correlationId", "acknowledgedAt"],
  "allOf": [{"if": {"properties": {"bindings": {"required": ["runId"]}}}, "then": {"required": ["stages"]}}],
  "$defs": {
    "bindings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "productSessionId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "hostSessionRef": {"type": "object", "additionalProperties": false, "properties": {"host": {"type": "string", "minLength": 1}, "sessionId": {"type": "string", "minLength": 1}}, "required": ["host", "sessionId"]},
        "storageNamespaceRef": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "storageKind": {"const": "local-filesystem"}, "adapter": {"type": "string", "minLength": 1}}, "required": ["id", "storageKind", "adapter"]}
      }
    }
  }
}
