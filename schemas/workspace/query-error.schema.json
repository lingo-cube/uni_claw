{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniclaw.dev/schemas/workspace/query-error/v1",
  "title": "UniClaw Workspace QueryError",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "uniclaw.workspace.query-error.v1"},
    "contractVersion": {"const": "uniclaw.workspace.contract.v1"},
    "code": {"enum": ["unavailable", "uncorrelated", "stale", "permission-denied", "not-found", "timeout"]},
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "source": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1}
  },
  "required": ["schemaVersion", "contractVersion", "code", "message", "retryable", "source"]
}
