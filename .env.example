# AI Vision Service
# Choose provider: anthropic, mimo, mock
VISION_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=your_api_key_here
VISION_MODEL=claude-3-5-sonnet-20241022

# XiaoMi MiMo
MIMO_API_KEY=your_mimo_api_key_here
MIMO_MODEL=mimo-v2.5
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ADB Configuration
ADB_DEVICE_ID=
ADB_PATH=adb

# Traversal Settings
MAX_STEPS=200
WAIT_TIME=0.5
MAX_RETRIES=2
TIMEOUT=30

# State Persistence
STATE_FILE=.traversal_state.json

# Logging
LOG_LEVEL=INFO
