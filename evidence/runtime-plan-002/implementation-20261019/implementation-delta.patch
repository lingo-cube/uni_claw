+        ScenarioExpectation? expectedOverride = null,
+        GoalSpec? goalOverride = null,
+        Func<AgentDecisionContext, bool>? continuePaused = null,
+        Action<PlanLanguageHandler, PlanHandlerInput>? inspectObserver = null)
