<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Slice 1 生产组合根（REALITY_COMPOSITION_FOUNDATION）。

    职责边界（Authority Boundary Audit — design.md）：
      - 生产 host / 组合入口：唯一允许「用真实 Provider 组合 PhysicalEnvironment」的代码位置。
      - 本工程引用 Runtime（核心语义）+ Adapters（真实 IO Provider）。
      - Fake/Replay/Simulation 环境不得出现在本工程（F1 架构断言 — ArchitectureGuardTests）。
      - 无 provider 注册表 / 发现 / 选择逻辑；组合是命令式、显式、直线代码（无运行时选择标志）。
  -->

  <ItemGroup>
    <ProjectReference Include="..\UniClaw.Runtime\UniClaw.Runtime.csproj" />
    <ProjectReference Include="..\UniClaw.Runtime.Adapters\UniClaw.Runtime.Adapters.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UniClaw.Runtime.PhysicalHost</RootNamespace>
    <AssemblyName>uniclaw-physical-host</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
