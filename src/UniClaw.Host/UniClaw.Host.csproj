<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UniClaw.Host</RootNamespace>
    <AssemblyName>UniClaw.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniClaw.ClaudeProvider\UniClaw.ClaudeProvider.csproj" />
    <ProjectReference Include="..\UniClaw.Core\UniClaw.Core.csproj" />
    <ProjectReference Include="..\UniClaw.DeepSeekProvider\UniClaw.DeepSeekProvider.csproj" />
    <ProjectReference Include="..\UniClaw.Device\UniClaw.Device.csproj" />
    <ProjectReference Include="..\UniClaw.LocalVisionProvider\UniClaw.LocalVisionProvider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LoggerFactory (composition root): Host owns the factory; Core/TraceTool only
         see the Abstractions surface (transitively). -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="*" />
    <!-- SkiaSharp: RunAssetHook.EncodeRawToPng 把 raw RGBA 编码为 PNG 存盘 (复用 Core 同一依赖,
         raw-rgba-screenshot-pipeline D-5). -->
    <PackageReference Include="SkiaSharp" Version="*" />
  </ItemGroup>

</Project>
