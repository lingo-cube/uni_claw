{
  "test_id": "e2e_all_traversal",
  "description": "全菜单遍历：验证深度优先顺序和恢复操作",
  "test_dir": "tests/simulation/fixtures/e2e_all_traversal",
  "intent_slots": {
    "target_app": "设置",
    "scope": "all_menus",
    "element_handling": "full_interaction",
    "navigation": "adaptive",
    "restore": true,
    "depth": 3
  },
  "fixtures": {
    "plan_file": "plan_all.json",
    "pages_file": "pages_all.json"
  },
  "expected": {
    "completion_reason": "completed",
    "key_events": [
      "点击 'Settings' 按钮",
      "进入 SettingsPage",
      "点击 'Display' 菜单项",
      "进入 DisplaySettings",
      "操作 'Brightness' 滑块并恢复",
      "操作 'Auto Brightness' 开关并恢复",
      "退出 DisplaySettings",
      "点击 'Sound' 菜单项",
      "进入 SoundSettings",
      "操作 'Volume' 滑块并恢复",
      "操作 'Mute' 开关并恢复",
      "退出 SoundSettings",
      "退出 SettingsPage",
      "遍历完成"
    ],
    "total_steps_min": 12,
    "total_steps_max": 30,
    "must_not_contain": ["错误", "异常", "失败", "崩溃", "ElementNotFoundException"]
  },
  "assertions": {
    "visited_nodes_min": 6,
    "restore_operations_count_min": 4,
    "navigation_correctness": "depth_first",
    "depth_first_order": [
      "Settings",
      "Display",
      "Brightness",
      "Auto Brightness",
      "Sound",
      "Volume",
      "Mute"
    ]
  }
}