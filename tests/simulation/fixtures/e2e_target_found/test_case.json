{
  "test_id": "e2e_target_found",
  "description": "目标搜索：验证找到特定目标后的完成",
  "test_dir": "tests/simulation/fixtures/e2e_target_found",
  "intent_slots": {
    "target_app": "设置",
    "scope": "target_search",
    "target_name": "BrightnessSlider",
    "element_handling": "minimal",
    "navigation": "direct",
    "restore": false,
    "depth": 2
  },
  "fixtures": {
    "plan_file": "plan_target.json",
    "pages_file": "pages_target.json"
  },
  "expected": {
    "completion_reason": "target_found",
    "key_events": [
      "进入 root",
      "点击 SettingsButton",
      "进入 settings",
      "点击 DisplayOption",
      "进入 display",
      "找到 BrightnessSlider",
      "目标完成"
    ],
    "total_steps_min": 5,
    "total_steps_max": 12,
    "must_not_contain": ["错误", "未找到目标"]
  },
  "assertions": {
    "visited_nodes_min": 3,
    "target_found": true,
    "early_termination": true
  }
}