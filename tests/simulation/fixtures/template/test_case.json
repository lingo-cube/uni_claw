    "total_steps_min": 5,
    "total_steps_max": 20,
    "must_not_contain": ["错误", "异常", "失败", "崩溃"]
  },
  "assertions": {
    "visited_nodes_min": 3,
    "restore_operations_count": 1,
    "navigation_correctness": "depth_first"
  }
}