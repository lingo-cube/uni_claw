{
  "entry_app": "com.example.checkout",
  "mode": "concrete",
  "meta": {
    "description": "Static path plan for checkout flow testing",
    "version": "1.0"
  },
  "entry_policy": {
    "strategy": "direct_deeplink",
    "fallback": "com.example.checkout/.MainActivity",
    "wait_condition": {
      "type": "screen_match",
      "text": "Shopping Cart",
      "match_mode": "contains",
      "timeout_seconds": 10
    }
  },
  "completion_policy": {
    "type": "max_steps",
    "max_steps": 200
  },
  "root_node": {
    "node_id": "cart_screen",
    "name": "Shopping Cart",
    "node_type": "screen",
    "operation": {
      "action": "click",
      "target": {
        "by": "text",
        "value": "Shopping Cart"
      }
    },
    "children_strategy": {
      "type": "static",
      "static_children": [
        "checkout_button",
        "continue_shopping"
      ]
    },
    "exit_condition": {
      "type": "all_children_visited",
      "fallback": "skip"
    },
    "error_policy": {
      "on_error": "abort",
      "max_retries": 0
    },
    "meta": {
      "screen_type": "cart",
      "is_root": true
    }
  },
  "static_nodes": {
    "checkout_button": {
      "node_id": "checkout_button",
      "name": "Checkout Button",
      "node_type": "action",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "Checkout"
        }
      },
      "precondition": {
        "ui_condition": "exists:text:Checkout",
        "timeout_seconds": 5.0
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "payment_screen"
        ]
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "button",
        "action_type": "navigation"
      }
    },
    "continue_shopping": {
      "node_id": "continue_shopping",
      "name": "Continue Shopping",
      "node_type": "action",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "Continue Shopping"
        }
      },
      "children_strategy": {
        "type": "none"
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "button",
        "action_type": "exit"
      }
    },
    "payment_screen": {
      "node_id": "payment_screen",
      "name": "Payment Screen",
      "node_type": "screen",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "payment_form"
        }
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "credit_card_option",
          "paypal_option"
        ]
      },
      "exit_condition": {
        "type": "single_level",
        "fallback": "back"
      },
      "error_policy": {
        "on_error": "backtrack",
        "max_retries": 1
      },
      "meta": {
        "screen_type": "form",
        "form_type": "payment"
      }
    },
    "credit_card_option": {
      "node_id": "credit_card_option",
      "name": "Credit Card Payment",
      "node_type": "action",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "Credit Card"
        }
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "card_details_form"
        ]
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "option",
        "payment_method": "credit_card"
      }
    },
    "paypal_option": {
      "node_id": "paypal_option",
      "name": "PayPal Payment",
      "node_type": "action",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "PayPal"
        }
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "paypal_redirect"
        ]
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "option",
        "payment_method": "paypal"
      }
    },
    "card_details_form": {
      "node_id": "card_details_form",
      "name": "Card Details Form",
      "node_type": "screen",
      "operation": {
        "action": "no_action",
        "params": {
          "duration_ms": 500
        }
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "submit_order"
        ]
      },
      "exit_condition": {
        "type": "single_level",
        "fallback": "back"
      },
      "error_policy": {
        "on_error": "backtrack",
        "max_retries": 1
      },
      "meta": {
        "screen_type": "form",
        "form_type": "card_details"
      }
    },
    "paypal_redirect": {
      "node_id": "paypal_redirect",
      "name": "PayPal Redirect",
      "node_type": "screen",
      "operation": {
        "action": "no_action",
        "params": {
          "duration_ms": 1000
        }
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "submit_order"
        ]
      },
      "exit_condition": {
        "type": "single_level",
        "fallback": "back"
      },
      "error_policy": {
        "on_error": "abort",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "redirect",
        "redirect_target": "paypal"
      }
    },
    "submit_order": {
      "node_id": "submit_order",
      "name": "Submit Order",
      "node_type": "action",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "Place Order"
        },
        "restore": {
          "action": "back"
        }
      },
      "precondition": {
        "ui_condition": "exists:text:Place Order",
        "timeout_seconds": 5.0
      },
      "children_strategy": {
        "type": "static",
        "static_children": [
          "confirmation_screen"
        ]
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "button",
        "action_type": "submit"
      }
    },
    "confirmation_screen": {
      "node_id": "confirmation_screen",
      "name": "Order Confirmation",
      "node_type": "screen",
      "operation": {
        "action": "click",
        "target": {
          "by": "text",
          "value": "Order Confirmed"
        }
      },
      "children_strategy": {
        "type": "none"
      },
      "error_policy": {
        "on_error": "skip",
        "max_retries": 0
      },
      "meta": {
        "screen_type": "confirmation",
        "is_terminal": true
      }
    }
  },
  "intent_slots": {
    "depth": 5,
    "scope": "partial"
  }
}
