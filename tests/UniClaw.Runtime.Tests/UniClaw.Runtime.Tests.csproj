<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UniClaw.Runtime.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniClaw.Runtime\UniClaw.Runtime.csproj" />
    <ProjectReference Include="..\..\src\UniClaw.Runtime.Adapters\UniClaw.Runtime.Adapters.csproj" />
    <ProjectReference Include="..\..\src\UniClaw.Runtime.Harness\UniClaw.Runtime.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Replay/Assets/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
