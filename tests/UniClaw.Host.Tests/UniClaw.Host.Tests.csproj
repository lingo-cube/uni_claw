<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UniClaw.Host.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Fixtures/LegacyEvidenceV1/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\RunRecoveryProbe\RunRecoveryProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\UniClaw.Host\UniClaw.Host.csproj" />
    <ProjectReference Include="..\..\src\UniClaw.Agent.Dsh\UniClaw.Agent.Dsh.csproj" />
    <!-- Shared test-only content gate; no reference to the Simulation composition root. -->
    <Compile Include="..\UniClaw.Simulation.Tests\ComponentReplay\ReplayCompositionGuard.cs" Link="PopupReplay\ReplayCompositionGuard.cs" />
    <Compile Include="..\UniClaw.Host.Dsh.Tests\PlanGenerationTrajectory.cs" Link="RealAgentSimulation\PlanGenerationTrajectory.cs" />
  </ItemGroup>

</Project>
