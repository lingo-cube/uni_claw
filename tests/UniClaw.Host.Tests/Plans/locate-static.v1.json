{
  "entryApp": "com.android.settings",
  "planName": "locate-about-phone-static",
  "planId": "locate-static-fixture",
  "entryPolicy": {
    "strategy": "bindCurrentScreen",
    "timeoutSeconds": 10
  },
  "rootNode": {
    "nodeId": "root",
    "name": "settings-root",
    "nodeType": "container",
    "operation": {
      "action": "noAction"
    },
    "childrenStrategy": {
      "type": "static",
      "staticChildren": [ "step-about" ]
    }
  },
  "staticNodes": {
    "step-about": {
      "nodeId": "step-about",
      "name": "About phone",
      "nodeType": "leafAction",
      "operation": {
        "action": "click",
        "target": {
          "by": "coordinate",
          "value": { "x": 0.5, "y": 0.7 }
        }
      },
      "childrenStrategy": {
        "type": "none"
      },
      "meta": {
        "expected_change": "change"
      }
    }
  },
  "mode": "concrete"
}
