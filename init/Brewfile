# =============================================================================
# Brewfile — 开发机 Homebrew 包清单
#   基线: macOS Intel (/usr/local); 新机器 Apple Silicon (/opt/homebrew) 通用
# 用法: brew bundle --file=init/Brewfile   （bootstrap.sh 已集成）
# 维护: 新增软件包时同时更新此文件（formula 进 tap "homebrew/core" 段,
#       GUI 应用进 cask 段）。
# 说明: 含传递依赖, 已装则跳过, 幂等。
# Apple Silicon 注意:
#   - brew 自动装对应架构 bottle; 个别无 ARM bottle 的 formula 会源码编译(慢)
#   - openssl@1.1 / python@3.9 已 EOL, 新机器可删去这两行
#   - gdb 在 ARM 上需要 codesign, 可选
# =============================================================================

tap "homebrew/cask"
tap "homebrew/core"
brew "brew-cask-completion"

# ---------------------------------------------------------------------------
# 核心工具链
# 注: git 由 Xcode Command Line Tools 提供(/usr/bin/git), brew 版本可选
