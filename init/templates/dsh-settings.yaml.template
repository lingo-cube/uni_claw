# =============================================================================
# ~/.dsh/settings.yaml — 由 init/scripts/setup-config.sh 从模板生成
# 参考: dk-harness/docs/config-catalog.md → @deepseek-ai/dsh-llm-deepseek
# =============================================================================

llm-deepseek:
  # 凭据来源: 环境变量名（DEEPSEEK_API_KEY 已配置于 ~/.zshrc）
  apiKeyEnv: DEEPSEEK_API_KEY

  # 自定义端点: 留空则用 DeepSeek 官方公共 API
  # baseURL:

  # 思考模式: enabled / disabled
  thinking: enabled

  # 思考强度: off / high / max
  reasoningEffort: high

  # 单次输出上限 tokens
  maxTokens: 256000

  # 模型目录未知时的默认上下文窗口
  defaultContextWindow: 1000000

  # Web UI 模型选择器展示的模型目录
  models:
    - id: deepseek-v4-pro
      contextWindow: 128000
    - id: deepseek-v4-flash
      contextWindow: 128000

ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1

ui-theme:
  preference: light

agent-default-model:
  provider: deepseek-official
