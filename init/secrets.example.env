# =============================================================================
# secrets.example.env — 新机器初始化时需手动提供的密钥清单
#
# 用法:
#   1. 复制本文件为 ~/secrets.env
#   2. 填入真实值
#   3. source ~/secrets.env && bash init/bootstrap.sh --config
#      （或直接 export 对应变量后运行）
#
# ⚠️ 本文件只含变量名示例, 不要在此提交真实密钥。
#    真实密钥来源:
#      DeepSeek:  https://platform.deepseek.com
#      Qwen MaaS: 阿里云百炼 (https://bailian.console.aliyun.com)
# =============================================================================

# --- DeepSeek（dsh / Claude Code 代理 / Codex deepseek provider 共用） ---
export DEEPSEEK_API_KEY="sk-..."
# Claude Code → DeepSeek Anthropic 兼容端点 (可用同一把 DeepSeek key)
export ANTHROPIC_AUTH_TOKEN="sk-..."
# Claude Code MIMO 模型
export MIMO_API_KEY="tp-..."

# --- Codex 备用 worker ---
# Qwen MaaS (qwen3.8-max / deepseek-v4-pro / deepseek-v4-flash-0731)
export QWEN_API_KEY="sk-..."
# SenseNova bearer token
export SENSENOVA_TOKEN="sk-..."

# --- git ---
export GIT_NAME="Fran"
export GIT_EMAIL="you@example.com"
# 代理地址, 无代理则留空
export GIT_PROXY="http://127.0.0.1:7890"

# --- 其他（可选, 视需要） ---
# export GH_TOKEN="ghp_..."           # GitHub CLI 认证
# export NPM_TOKEN="npm_..."          # 私有 npm registry
